# Reference only. Enter actual values through the TrueNAS Custom App UI.
# Do not commit a filled copy or credentials.
PUID=568
PGID=568
MEDIA_JOBS_HOST_PATH=/mnt/L.T.D.S./Drone_Jobs/Jobs
WORKERS_APP_DATA_HOST_PATH=/mnt/Plugins/App_Data/LedgeTop-Ops-Workers
LTDSPROXY_MAX_CONCURRENT=6
LTDSPROXY_FFMPEG_THREADS=2
LTDSPROXY_MAX_HEIGHT=720
LTDSPROXY_SLEEP_SECONDS=900
LTDSPROXY_SOURCE_STABLE_SECONDS=60
LTDSPROXY_REGENERATION_VERSION=7
LTDSTHUMB_WORKER_CONCURRENCY=4
LTDSTHUMB_API_BASE=https://incoming.ledgetopdroneservices.com/api/internal/thumbnail-renderer/v1
THUMBNAIL_INGEST_SECRET=REPLACE_IN_TRUENAS_UI
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional local-prebuilt overlay only; not needed by the default stack.
# LTDSTHUMB_INGEST_URL=https://ops.ledgetopdroneservices.com/api/internal/thumbnail-ingest/v1
# LTDSTHUMB_BROKER_ACCESS_CLIENT_ID=REPLACE_IN_TRUENAS_UI
# LTDSTHUMB_BROKER_ACCESS_CLIENT_SECRET=REPLACE_IN_TRUENAS_UI
# LTDSTHUMB_R2_ACCOUNT_ID=REPLACE_IN_TRUENAS_UI
# LTDSTHUMB_R2_BUCKET_NAME=client-data
# LTDSTHUMB_R2_ACCESS_KEY_ID=REPLACE_WITH_BROKER_OBJECT_READ_KEY
# LTDSTHUMB_R2_SECRET_ACCESS_KEY=REPLACE_WITH_BROKER_OBJECT_READ_SECRET

# Flight logs backend (compose.truenas.all.yaml only). Its own settings and secrets are NOT here: they live in
# <WORKERS_APP_DATA_HOST_PATH>/flight-logs/config/logs.env, which the app writes blank on first start.
# LOGS_BIND_ADDRESS=REPLACE_WITH_NAS_LAN_ADDRESS_THE_REVERSE_PROXY_FORWARDS_TO
# LOGS_INGRESS_HOST=REPLACE_WITH_THE_PUBLIC_LOGS_HOSTNAME
# Optional (the stack starts without them; Logs then uses only its own logs.env):
# NAS_LINK_ENV_FILE=REPLACE_WITH_THE_PRIVATE_PATH_OF_nas-link.env (see nas-link.env.example)
