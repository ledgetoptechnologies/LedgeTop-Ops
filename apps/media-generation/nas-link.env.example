# The shared NAS link settings file: ONE file on the NAS that every networked container in this stack reads
# (Compose env_file: NAS_LINK_ENV_FILE). Copy it to a private place on the NAS (mode 600) and fill it there.
# Never commit a filled copy. Values appear in `docker inspect` to NAS administrators.
#
# The one Cloudflare Access service token ("NAS link"): client id and secret.
NAS_LINK_CLIENT_ID=
NAS_LINK_CLIENT_SECRET=
# The AUD tag of the one Access application that covers the NAS hostnames (used by services Ops calls in to).
NAS_LINK_AUDIENCE=
# The Ops origin the containers call (production: https://ops.ledgetop.app). Staging sets its own.
OPS_BASE_URL=
