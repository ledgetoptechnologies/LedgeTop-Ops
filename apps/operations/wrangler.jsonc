{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ltds-ops",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ops.ledgetopdroneservices.com", "custom_domain": true },
    { "pattern": "incoming.ledgetopdroneservices.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/r/*"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://ops.ledgetopdroneservices.com",
    "EXPECTED_HOST": "ops.ledgetopdroneservices.com",
    "DIRECT_DELIVERY_UPLOADS_ENABLED": "false",
    "INCOMING_BASE_URL": "https://incoming.ledgetopdroneservices.com",
    "INCOMING_EXPECTED_HOST": "incoming.ledgetopdroneservices.com",
    "ENVIRONMENT": "production",
    "TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "OPERATIONS_AUD": "d09e298c864b9c8f4491b4b42a4dbe2ecbf558b5868d18258443740e56032407",
    "DELIVERY_BASE_URL": "https://client.ledgetopdroneservices.com",
    "PROJECT_ALPHA_BASE_URL": "https://project-alpha.ledgetopdroneservices.com",
    "APPLICATION_KEY": "ltds_ops",
    "TFR_REGION": "WI",
    "DISPLAY_TIMEZONE": "America/Chicago",
    "MAP_STYLE_URL": "",
    "STREAM_ACCOUNT_ID": "",
    "STREAM_CUSTOMER_CODE": "",
    "R2_ACCOUNT_ID": "846c924bf17bf4f3dd15c97a4c5d1d51",
    "R2_BUCKET_NAME": "client-data",
    "R2_PURGE_ENABLED": "false",
    "R2_INCOMING_BUCKET_NAME": "ltds-incoming",
    "FILE_EVENTS_QUEUE_NAME": "ltds-file-events",
    "THUMBNAIL_QUEUE_NAME": "ltds-thumbnail-jobs",
    "THUMBNAIL_DLQ_NAME": "ltds-thumbnail-jobs-dlq",
    "THUMBNAIL_INGEST_EXPECTED_HOST": "ops.ledgetopdroneservices.com",
    "ALERT_FROM": "",
    "ALERT_TO": "",
    "NOTIFICATION_FROM": "delivery@ledgetopdroneservices.com",
    "SMTP_NOTIFICATIONS_ENABLED": "true",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_FROM": "no-reply@ledgetoptechnologies.com",
    "SMTP_USERNAME": "no-reply@ledgetoptechnologies.com",
    "CLIENT_REQUEST_TRIAGE_TO": "beaukoltz@ledgetopdroneservices.com",
    "DROPBOX_IMPORT_ENABLED": "false",
    "DROPBOX_CLIENT_ID": ""
  },
  "send_email": [{ "name": "NOTIFICATION_EMAIL", "allowed_sender_addresses": ["delivery@ledgetopdroneservices.com"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *"] },
  "r2_buckets": [
    { "binding": "DATA_BUCKET", "bucket_name": "client-data" },
    { "binding": "INCOMING_BUCKET", "bucket_name": "ltds-incoming" }
  ],
  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "ltds-ops",
      "database_id": "6ebf7514-d306-4615-ae56-ad869c874dbd",
      "migrations_dir": "migrations"
    },
    {
      "binding": "DELIVERY_DB",
      "database_name": "client-data",
      "database_id": "7f40a7b7-c3ec-470e-a626-e798867f71f8",
      "migrations_dir": "../client/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "THUMBNAIL_QUEUE", "queue": "ltds-thumbnail-jobs" }
    ],
    "consumers": [
      { "queue": "ltds-file-events", "max_batch_size": 25, "max_batch_timeout": 10, "max_retries": 5 },
      {
        "queue": "ltds-thumbnail-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "ltds-thumbnail-jobs-dlq"
      },
      {
        "queue": "ltds-thumbnail-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "stream": { "binding": "STREAM" },
  "durable_objects": {
    "bindings": [
      { "name": "THUMBNAIL_RENDERER", "class_name": "ThumbnailRendererContainer" }
    ]
  },
  "migrations": [
    { "tag": "thumbnail-renderer-v1", "new_sqlite_classes": ["ThumbnailRendererContainer"] }
  ],
  "containers": [
    {
      "class_name": "ThumbnailRendererContainer",
      "image": "./containers/thumbnail-renderer/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1",
      "constraints": { "regions": ["WNAM"] },
      "ssh": { "enabled": false }
    }
  ]
  ,"workflows": [
    {
      "name": "ltds-r2-crud",
      "binding": "R2_CRUD_WORKFLOW",
      "class_name": "R2CrudWorkflow"
    },
    {
      "name": "ltds-incoming-upload-lifecycle",
      "binding": "INCOMING_LIFECYCLE_WORKFLOW",
      "class_name": "IncomingUploadLifecycleWorkflow"
    },
    {
      "name": "ltds-dropbox-import",
      "binding": "DROPBOX_IMPORT_WORKFLOW",
      "class_name": "DropboxImportWorkflow"
    }
  ]
}
