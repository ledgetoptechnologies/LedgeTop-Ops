{
  "name": "@ltds/operations",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run --config vitest.config.ts",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply ltds-ops --local",
    "db:migrate:remote": "wrangler d1 migrations apply ltds-ops --remote"
  },
  "dependencies": {
    "@ltds/shared": "file:../../packages/shared",
    "@ltds/ui": "file:../../packages/ui",
    "hono": "^4.9.9",
    "jose": "^6.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.14",
    "@cloudflare/workers-types": "^5.20260716.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.0",
    "wrangler": "^4.111.0"
  }
}
