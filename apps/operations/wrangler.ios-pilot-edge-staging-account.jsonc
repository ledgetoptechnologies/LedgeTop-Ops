{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledge-top-ios-edge-staging",
  "main": "src/worker/staging-ios-edge-entrypoint.ts",
  "account_id": "df3f376bae6ee621f50cf972ebcc9484",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "routes": [],
  "vars": {
    "ENVIRONMENT": "staging",
    "IOS_MANAGED_PILOT_ENABLED": "false",
    "IOS_OAUTH_PROBE_ENABLED": "false",
    "IOS_MANAGED_PILOT_ORIGIN": "https://ledge-top-ios-edge-staging.ledge-top-staging.workers.dev",
    "IOS_MANAGED_PILOT_AUDIENCE": "17f32ab9f964a3e4c64864e06d3d0e1b128604192b9a7e457db1f8f88b8f5707",
    "TEAM_DOMAIN": "https://ledge-top-staging.cloudflareaccess.com",
    "OPERATIONS_AUD": "ffb0d85b1929560fbafd7476a987401e0e25dc5000a251fcdcf85bc2ae5d7f84"
  },
  "services": [{
    "binding": "IOS_PILOT_READ",
    "service": "ledge-top-ios-read-staging",
    "entrypoint": "IosPilotReadService"
  }]
}
