+                var expected = OldPackedLevel(varied, size.Width, size.Height, components);
+                var guarded = Filled(capacity + 8, 0xA5);
+                Marshal.Copy(guarded, 0, allocation, guarded.Length);
+                Upload(varied, size.Width, size.Height, components,
