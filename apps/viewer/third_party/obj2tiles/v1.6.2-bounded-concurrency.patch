+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace Obj2Tiles.Library;
+
+// One face per line, bounded serialization; final manifest must bind this sidecar hash.
+public sealed class TextureChartMappingWriter : IDisposable
+{
+    private readonly StreamWriter writer;
+    public TextureChartMappingWriter(string path, string? sourceObjSha256)
+    {
+        writer = new StreamWriter(new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.Read),
+            new System.Text.UTF8Encoding(false), 16384);
+        try
+        {
+            writer.WriteLine(JsonSerializer.Serialize(new { schemaVersion = 1, recordType = "source",
+                policy = "bounded-texture-mapping-candidate-v1", sourceObjSha256,
+                sourceBound = sourceObjSha256 != null }));
+        }
+        catch { writer.Dispose(); throw; }
+    }
+    public static string HashFile(string path)
+    {
+        using var stream = File.OpenRead(path);
+        return Convert.ToHexString(SHA256.HashData(stream)).ToLowerInvariant();
+    }
+    public void WriteFace(string lodTileIdentity, int chartId, int faceId, int materialId,
+        string? sourceSha256, string? normalSha256, int sourceWidth, int sourceHeight,
+        int cropX, int cropTopY, int cropWidth, int cropHeight, int sourceTileU, int sourceTileV, int atlasInnerX, int atlasInnerY,
+        int atlasEdge, double scaleX, double scaleY, string atlasIdentity, double[] originalUv, double[] atlasUv, double[] triangle)
+    {
+        if (Path.GetFileName(atlasIdentity) != atlasIdentity || atlasIdentity.Contains('\\')
+            || atlasIdentity.Contains('/') || atlasIdentity is "." or "..")
+            throw new InvalidDataException("mapping_identity_invalid");
+        // lodTileIdentity is generated by SplitStage, never a source absolute path.
+        if (string.IsNullOrEmpty(lodTileIdentity) || lodTileIdentity.Contains('/') || lodTileIdentity.Contains('\\'))
+            throw new InvalidDataException("mapping_lod_identity_invalid");
+        writer.WriteLine(JsonSerializer.Serialize(new { schemaVersion = 1, recordType = "face", lodTileIdentity, chartId, faceId,
+            materialId, sourceSha256, normalSha256, sourceWidth, sourceHeight, cropX, cropTopY,
+            cropWidth, cropHeight, sourceTileU, sourceTileV, atlasInnerX, atlasInnerY, atlasEdge, scaleX, scaleY,
+            atlasIdentity, originalUv, atlasUv, triangle }));
+    }
+    public void WriteAtlas(string path, int width, int height)
+    {
+        writer.WriteLine(JsonSerializer.Serialize(new { schemaVersion = 1, recordType = "atlas",
+            identity = Path.GetFileName(path), sha256 = HashFile(path), width, height }));
+    }
+    // Preserve exact pre-KTX images for an independent pixel/mapping verifier.
+    // Output-side proof is transient but must outlive converter temporary-tree cleanup.
+    public static string PreserveAtlasProof(string mappingPath, string proofDirectory)
+    {
+        Directory.CreateDirectory(proofDirectory);
+        var manifestPath = Path.Combine(proofDirectory, "atlas-manifest.jsonl");
+        var atlasCount = 0;
+        using (var output = new StreamWriter(new FileStream(manifestPath, FileMode.CreateNew,
+            FileAccess.Write, FileShare.Read), new System.Text.UTF8Encoding(false), 16384))
+        using (var input = File.OpenText(mappingPath))
+        {
+            string? line;
+            while ((line = ReadBoundedRecord(input, 16384)) != null)
+            {
+                if (line.Length > 16384) throw new InvalidDataException("mapping_record_too_large");
+                using var doc = JsonDocument.Parse(line);
+                var record = doc.RootElement;
+                if (record.GetProperty("recordType").GetString() != "atlas") continue;
+                atlasCount = checked(atlasCount + 1);
+                var identity = record.GetProperty("identity").GetString()
+                    ?? throw new InvalidDataException("proof_identity_missing");
+                if (Path.GetFileName(identity) != identity || identity.Contains('/') || identity.Contains('\\')
+                    || identity is "." or "..") throw new InvalidDataException("proof_identity_invalid");
+                var sha256 = record.GetProperty("sha256").GetString();
+                var source = Path.Combine(Path.GetDirectoryName(mappingPath)!, identity);
+                if (HashFile(source) != sha256) throw new InvalidDataException("proof_source_digest_mismatch");
+                var destination = Path.Combine(proofDirectory, identity);
+                File.Copy(source, destination, overwrite: false);
+                if (HashFile(destination) != sha256) throw new InvalidDataException("proof_copy_digest_mismatch");
+                output.WriteLine(JsonSerializer.Serialize(new { schemaVersion = 1, identity, sha256,
+                    width = record.GetProperty("width").GetInt32(),
+                    height = record.GetProperty("height").GetInt32(), byteSize = new FileInfo(destination).Length }));
+            }
+        }
+        if (atlasCount == 0) throw new InvalidDataException("proof_atlas_missing");
+        return HashFile(manifestPath);
+    }
+    private static string? ReadBoundedRecord(TextReader reader, int limit)
+    {
+        var buffer = new System.Text.StringBuilder(Math.Min(limit, 1024));
+        int value;
+        while ((value = reader.Read()) != -1)
+        {
+            if (value == '\n') return buffer.ToString();
+            if (buffer.Length >= limit) throw new InvalidDataException("mapping_record_too_large");
+            if (value != '\r') buffer.Append((char)value);
+        }
+        return buffer.Length == 0 ? null : buffer.ToString();
+    }
+    public void Dispose() => writer.Dispose();
+}
