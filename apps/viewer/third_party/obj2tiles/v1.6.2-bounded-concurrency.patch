+using SixLabors.ImageSharp;
+using SixLabors.ImageSharp.Formats;
+using SixLabors.ImageSharp.PixelFormats;
+
+namespace Obj2Tiles.Library;
+
+// Allocation guards, not a claim about total managed/native process memory.
+public static class TextureAllocationBudget
+{
+    public const int MaxSourceEdge = 8192;
+    public const int MaxAtlasEdge = 16384;
+    public const long MaxPixels = (long)MaxSourceEdge * MaxSourceEdge;
+
+    public static long ValidatePixels(int width, int height)
+    {
+        var pixels = checked((long)width * height);
+        if (width < 1 || height < 1 || width > MaxSourceEdge || height > MaxSourceEdge || pixels > MaxPixels)
+            throw new InvalidDataException("texture_pixel_budget_exceeded");
+        return checked(pixels * 4);
+    }
+
+    public static long ValidateAtlas(int width, int height)
+    {
+        var pixels = checked((long)width * height);
+        if (width < 1 || height < 1 || width > MaxAtlasEdge || height > MaxAtlasEdge)
+            throw new InvalidDataException("atlas_pixel_budget_exceeded");
+        return checked(pixels * 4);
+    }
+
+    // OBJ V is bottom-up. Crop originY is ImageSharp top-down.
+    public static (double U, double V) MapSourceUv(double u, double v, int sourceWidth,
+        int sourceHeight, int cropX, int cropTopY, int cropWidth, int cropHeight,
+        int atlasInnerX, int atlasInnerY, int atlasEdge, double scaleX, double scaleY)
+    {
+        if (!double.IsFinite(u) || !double.IsFinite(v)
+            || !double.IsFinite(scaleX) || !double.IsFinite(scaleY) || scaleX <= 0 || scaleY <= 0)
+            throw new InvalidDataException("texture_mapping_nonfinite");
+        ValidatePixels(sourceWidth, sourceHeight);
+        ValidateAtlas(atlasEdge, atlasEdge);
+        if (cropX < 0 || cropTopY < 0 || cropWidth < 1 || cropHeight < 1
+            || checked((long)cropX + cropWidth) > sourceWidth
+            || checked((long)cropTopY + cropHeight) > sourceHeight
+            || scaleX > 1 || scaleY > 1 || atlasInnerX < 0 || atlasInnerY < 0)
+            throw new InvalidDataException("texture_mapping_bounds_invalid");
+        // Match pixel-centre cropping exactly; no chart-bbox normalization.
+        return ((atlasInnerX + (u * sourceWidth - cropX) * scaleX) / atlasEdge,
+            1.0 - (atlasInnerY + ((1.0 - v) * sourceHeight - cropTopY) * scaleY) / atlasEdge);
+    }
+
+    public static Image<Rgba32> LoadSource(string path)
+    {
+        // ImageSharp 3.2.0 PNG Identify does not populate static frame metadata.
+        // Bound both passes. Three is required because its APNG decoder stops before
+        // decoding the frame whose fcTL count reaches MaxFrames: two can hide frame 2.
+        // This permits at most three decoded frames; none are returned unless there is one.
+        var options = new DecoderOptions { MaxFrames = 3 };
+        var info = Image.Identify(options, path) ?? throw new InvalidDataException("texture_header_missing");
+        ValidatePixels(info.Width, info.Height);
+        if (info.FrameMetadataCollection.Count > 1)
+            throw new InvalidDataException("texture_multiframe_unsupported");
+        var image = Image.Load<Rgba32>(options, path);
+        try
+        {
+            ValidatePixels(image.Width, image.Height);
+            if (image.Frames.Count != 1) throw new InvalidDataException("texture_multiframe_unsupported");
+            return image;
+        }
+        catch { image.Dispose(); throw; }
+    }
+
+    public static int AtlasEdge(double area, double chartWidth, double chartHeight)
+    {
+        if (!double.IsFinite(area) || !double.IsFinite(chartWidth) || !double.IsFinite(chartHeight)
+            || area < 0 || chartWidth < 0 || chartHeight < 0)
+            throw new InvalidDataException("texture_chart_invalid");
+        if (chartWidth > MaxAtlasEdge || chartHeight > MaxAtlasEdge)
+            throw new InvalidDataException("texture_chart_requires_lossless_partition");
+        var requested = Math.Max(32, Math.Max(Math.Ceiling(Math.Sqrt(area)), Math.Max(chartWidth, chartHeight)));
+        var edge = 32;
+        while (edge < requested && edge < MaxAtlasEdge) edge = checked(edge * 2);
+        ValidateAtlas(edge, edge);
+        return edge;
+    }
+}
