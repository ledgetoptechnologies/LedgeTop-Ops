+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Reflection;
+using NUnit.Framework;
+using Obj2Tiles.Library.Geometry;
+using Obj2Tiles.Library.Materials;
+
+namespace Obj2Tiles.Test;
+
+public class TextureChartBoundaryTests
+{
+    // Exercise the exact production tile selector without allocating images or
+    // invoking decimation/native compression. Test each interval on both axes.
+    private static (int U, int V) Select(double min, double max, bool swap)
+    {
+        var uv = swap
+            ? new[] { new Vertex2(.2, min), new Vertex2(.8, min), new Vertex2(.5, max) }
+            : new[] { new Vertex2(min, .2), new Vertex2(max, .2), new Vertex2(min, .8) };
+        var mesh = new MeshT(Array.Empty<Vertex3>(), uv,
+            new[] { new FaceT(0, 1, 2, 0, 1, 2, 0) }, Array.Empty<Material>());
+        IReadOnlyList<int> cluster = new[] { 0 };
+        var selectMethod = typeof(MeshT).GetMethod("GetClusterTextureTiles", BindingFlags.Instance | BindingFlags.NonPublic)!;
+        return selectMethod.CreateDelegate<Func<IReadOnlyList<int>, (int U, int V)>>(mesh)(cluster);
+    }
+
+    [TestCase(0.0, 1.0, 0)]
+    [TestCase(0.0, .00005, 0)]
+    [TestCase(.99995, 1.0, 0)]
+    [TestCase(.99992, 1.0, 0)] // RectangleF min+width reconstructs above 1.
+    [TestCase(0.0, .000001, 0)]
+    [TestCase(.999999, 1.0, 0)]
+    [TestCase(-1.0, 0.0, -1)]
+    [TestCase(-1.0, -.99995, -1)]
+    [TestCase(-.00005, 0.0, -1)]
+    [TestCase(2.0, 3.0, 2)]
+    [TestCase(2.99995, 3.0, 2)]
+    [TestCase(.25, .25, 0)]
+    [TestCase(0.0, 0.0, 0)]
+    [TestCase(1.0, 1.0, 1)]
+    [TestCase(-1.0, -1.0, -1)]
+    public void ClosedSingleTileIntervalsPreserveTileAndSupportBoundarySlivers(double min, double max, int tile)
+    {
+        foreach (var swap in new[] { false, true })
+        {
+            var actual = Select(min, max, swap);
+            Assert.That(swap ? actual.V : actual.U, Is.EqualTo(tile));
+            Assert.That(swap ? actual.U : actual.V, Is.Zero);
+        }
+    }
+
+    [TestCase(.9, 1.1)]
+    [TestCase(.5, 1.00005)]
+    [TestCase(.9998, 1.00005)]
+    [TestCase(-.0002, .00005)]
+    [TestCase(.99995, 1.0002)]
+    [TestCase(-.00005, .0002)]
+    [TestCase(.99995, 1.00005)]
+    [TestCase(-.00005, .00005)]
+    [TestCase(-1.1, -.9)]
+    [TestCase(0.0, 2.0)]
+    public void GenuineCrossingsStillFail(double min, double max)
+    {
+        foreach (var swap in new[] { false, true })
+            Assert.That(() => Select(min, max, swap),
+                Throws.TypeOf<InvalidDataException>().With.Message.EqualTo("texture_chart_crosses_udim_tile"));
+    }
+
+    [Test]
+    public void EveryLegalLegacyAcceptedAxisKeepsItsOriginalTile()
+    {
+        // Legacy accepted some asymmetric genuine crossings. Only intervals
+        // wholly inside one closed tile qualify for compatibility preservation.
+        var points = new[] { -1.00005, -1.0, -.99995, -.5, -.00005, 0, .00005,
+            .25, .5, .99995, 1.0, 1.00005, 1.5, 2.0 };
+        int checkedAxes = 0;
+        foreach (var min in points)
+        foreach (var max in points)
+        {
+            if (min > max || max > Math.Floor(min) + 1) continue;
+            double left = (float)min;
+            double right = left + (float)(max - min);
+            int legacy = (int)Math.Floor(left + 1e-4);
+            if (Math.Floor(right - 1e-4) != legacy) continue;
+            foreach (var swap in new[] { false, true })
+            {
+                var actual = Select(min, max, swap);
+                Assert.That(swap ? actual.V : actual.U, Is.EqualTo(legacy));
+                checkedAxes++;
+            }
+        }
+        Assert.That(checkedAxes, Is.GreaterThan(50));
+    }
+
+    [TestCase(double.NaN, 1.0)]
+    [TestCase(0.0, double.NaN)]
+    [TestCase(double.NegativeInfinity, 0.0)]
+    [TestCase(0.0, double.PositiveInfinity)]
+    [TestCase(1.0, 0.0)]
+    [TestCase(-2147483649.0, -2147483649.0)]
+    [TestCase(2147483648.0, 2147483648.0)]
+    public void ClosedFallbackRejectsInvalidBounds(double min, double max)
+    {
+        var method = typeof(MeshT).GetMethod("ResolveClosedTextureTile", BindingFlags.Static | BindingFlags.NonPublic)!;
+        var resolve = method.CreateDelegate<Func<double, double, int>>();
+        Assert.That(() => resolve(min, max),
+            Throws.TypeOf<InvalidDataException>().With.Message.EqualTo("texture_chart_crosses_udim_tile"));
+    }
+}
