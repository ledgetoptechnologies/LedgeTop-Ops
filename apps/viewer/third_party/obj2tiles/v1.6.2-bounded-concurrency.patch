+using System;
+using System.IO;
+using NUnit.Framework;
+using Obj2Tiles.Library;
+using SixLabors.ImageSharp;
+using SixLabors.ImageSharp.Formats;
+using SixLabors.ImageSharp.Formats.Png;
+using SixLabors.ImageSharp.PixelFormats;
+
+namespace Obj2Tiles.Library.Test;
+
+public class TextureAllocationBudgetTests
+{
+    [TestCase("norm")]
+    [TestCase("bump")]
+    [TestCase("map_Bump")]
+    [TestCase("map_Ks")]
+    [TestCase("disp")]
+    public void UnsupportedTextureRolesFailBeforeMtlRewrite(string role)
+    {
+        var path = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".mtl");
+        try
+        {
+            File.WriteAllText(path, "newmtl test\n" + role + " texture.png\n");
+            Assert.Throws<InvalidDataException>(() => Obj2Tiles.Library.Materials.Material.ReadMtl(path, out _));
+        }
+        finally { File.Delete(path); }
+    }
+
+    [Test]
+    public void PreKtxAtlasProofSurvivesDeletionOfConverterTemporaryFiles()
+    {
+        var directory = Path.Combine(Path.GetTempPath(), Guid.NewGuid().ToString());
+        var input = Path.Combine(directory, "input");
+        var output = Path.Combine(directory, "proof");
+        Directory.CreateDirectory(input);
+        try
+        {
+            var source = Path.Combine(input, "atlas.png");
+            var mapping = Path.Combine(input, "mapping.jsonl");
+            using (var image = new Image<Rgba32>(8, 8)) image.SaveAsPng(source);
+            var digest = TextureChartMappingWriter.HashFile(source);
+            using (var writer = new TextureChartMappingWriter(mapping, new string('a', 64)))
+                writer.WriteAtlas(source, 8, 8);
+            var manifestDigest = TextureChartMappingWriter.PreserveAtlasProof(mapping, output);
+            File.Delete(source);
+            Assert.That(TextureChartMappingWriter.HashFile(Path.Combine(output, "atlas.png")), Is.EqualTo(digest));
+            Assert.That(manifestDigest, Is.EqualTo(TextureChartMappingWriter.HashFile(Path.Combine(output, "atlas-manifest.jsonl"))));
+        }
+        finally { Directory.Delete(directory, true); }
+    }
+
+    [Test]
+    public void Full8192ChartPlusBleedFitsWithoutShrinking()
+    {
+        Assert.That(TextureAllocationBudget.AtlasEdge(8196d * 8196, 8196, 8196), Is.EqualTo(16384));
+        Assert.That(TextureAllocationBudget.ValidateAtlas(16384, 16384), Is.EqualTo(1073741824L));
+    }
+
+    [Test]
+    public void RoundedCropOriginDoesNotRenormalizeSourceTexelScale()
+    {
+        var first = TextureAllocationBudget.MapSourceUv(0.12345, 0.76543, 8192, 8192,
+            1011, 1921, 400, 400, 2, 2, 16384, 1, 1);
+        var next = TextureAllocationBudget.MapSourceUv(0.12345 + 1d / 8192, 0.76543 + 1d / 8192,
+            8192, 8192, 1011, 1921, 400, 400, 2, 2, 16384, 1, 1);
+        Assert.That((next.U - first.U) * 16384, Is.EqualTo(1).Within(1e-9));
+        Assert.That((next.V - first.V) * 16384, Is.EqualTo(1).Within(1e-9));
+        Assert.That(first.U * 16384, Is.EqualTo(2 + 0.12345 * 8192 - 1011).Within(1e-9));
+    }
+
+    [Test]
+    public void AtlasRollsOverRatherThanGrowingWithTotalChartArea()
+    {
+        Assert.That(TextureAllocationBudget.AtlasEdge(1e15, 100, 100), Is.EqualTo(16384));
+        Assert.That(TextureAllocationBudget.AtlasEdge(1024, 32, 32), Is.EqualTo(32));
+    }
+
+    [Test]
+    public void OversizedChartFailsClosedWithoutReducingPixelDensity()
+    {
+        Assert.Throws<InvalidDataException>(() => TextureAllocationBudget.AtlasEdge(1, 16388, 1));
+        Assert.Throws<InvalidDataException>(() => TextureAllocationBudget.AtlasEdge(double.PositiveInfinity, 1, 1));
+        Assert.Throws<InvalidDataException>(() => TextureAllocationBudget.AtlasEdge(1, double.NaN, 1));
+    }
+
+    [Test]
+    public void ImageDimensionsHaveCheckedPixelAndByteBudgets()
+    {
+        Assert.That(TextureAllocationBudget.ValidatePixels(8192, 8192), Is.EqualTo(268435456));
+        Assert.Throws<InvalidDataException>(() => TextureAllocationBudget.ValidatePixels(int.MaxValue, int.MaxValue));
+        Assert.Throws<InvalidDataException>(() => TextureAllocationBudget.ValidatePixels(0, 1));
+    }
+
+    [TestCase(PngColorType.Rgb)]
+    [TestCase(PngColorType.RgbWithAlpha)]
+    public void StaticPngWithoutFrameMetadataPreservesPixels(PngColorType colorType)
+    {
+        var path = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".png");
+        var pixel = new Rgba32(25, 90, 180, colorType == PngColorType.Rgb ? (byte)255 : (byte)71);
+        try
+        {
+            using (var fixture = new Image<Rgba32>(8, 8, pixel))
+                fixture.SaveAsPng(path, new PngEncoder { ColorType = colorType });
+            // Pin the 3.2.0 Identify behavior that caused the original regression.
+            Assert.That(Image.Identify(path).FrameMetadataCollection.Count, Is.Zero);
+            using var image = TextureAllocationBudget.LoadSource(path);
+            Assert.That(image.Width, Is.EqualTo(8));
+            Assert.That(image.Height, Is.EqualTo(8));
+            Assert.That(image.Frames.Count, Is.EqualTo(1));
+            for (var y = 0; y < image.Height; y++)
+                for (var x = 0; x < image.Width; x++)
+                    Assert.That(image[x, y], Is.EqualTo(pixel));
+        }
+        finally { File.Delete(path); }
+    }
+
+    [Test]
+    public void StaticRgbJpegLoadsAsOneOpaqueFrame()
+    {
+        var path = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".jpg");
+        try
+        {
+            using (var fixture = new Image<Rgb24>(8, 8, new Rgb24(25, 90, 180)))
+                fixture.SaveAsJpeg(path);
+            using var image = TextureAllocationBudget.LoadSource(path);
+            Assert.That(image.Width, Is.EqualTo(8));
+            Assert.That(image.Height, Is.EqualTo(8));
+            Assert.That(image.Frames.Count, Is.EqualTo(1));
+            Assert.That(image[0, 0].R, Is.EqualTo(25).Within(3));
+            Assert.That(image[0, 0].G, Is.EqualTo(90).Within(3));
+            Assert.That(image[0, 0].B, Is.EqualTo(180).Within(3));
+            Assert.That(image[0, 0].A, Is.EqualTo(255));
+        }
+        finally { File.Delete(path); }
+    }
+
+    [TestCase("png", 2, true)]
+    [TestCase("png", 2, false)]
+    [TestCase("png", 5, true)]
+    [TestCase("png", 5, false)]
+    [TestCase("gif", 2, true)]
+    [TestCase("gif", 5, true)]
+    public void AnimatedSourcesAreRejectedWithBoundedDecoding(string extension, int frameCount, bool animateRoot)
+    {
+        var path = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + "." + extension);
+        try
+        {
+            using (var fixture = new Image<Rgba32>(8, 8, new Rgba32(255, 0, 0)))
+            {
+                for (var frame = 1; frame < frameCount; frame++)
+                {
+                    using var next = new Image<Rgba32>(8, 8, new Rgba32(0, (byte)(frame * 40), 255));
+                    fixture.Frames.AddFrame(next.Frames.RootFrame);
+                }
+                if (extension == "png")
+                {
+                    fixture.Metadata.GetPngMetadata().AnimateRootFrame = animateRoot;
+                    fixture.SaveAsPng(path);
+                }
+                else fixture.SaveAsGif(path);
+            }
+            // Verify the encoder output by decoding it, before testing header rejection.
+            using (var decoded = Image.Load<Rgba32>(new DecoderOptions { MaxFrames = 3 }, path))
+            {
+                Assert.That(decoded.Frames.Count, Is.GreaterThan(1));
+                Assert.That(decoded.Frames.Count, Is.LessThanOrEqualTo(3));
+            }
+            if (extension == "png")
+            {
+                if (frameCount == 2 && animateRoot)
+                {
+                    // A two-frame cap hides this animation in the pinned decoder.
+                    using var truncated = Image.Load<Rgba32>(new DecoderOptions { MaxFrames = 2 }, path);
+                    Assert.That(truncated.Frames.Count, Is.EqualTo(1));
+                }
+                // 3.2.0 Identify overskips fdAT sequence bytes and rejects these valid APNGs.
+                // Pin that exact fail-closed header path; do not fall back to unbounded decode.
+                var identifyError = Assert.Throws<InvalidImageContentException>(() =>
+                    Image.Identify(new DecoderOptions { MaxFrames = 3 }, path));
+                Assert.That(identifyError!.Message, Is.EqualTo("Invalid PNG data."));
+                var pngError = Assert.Throws<InvalidImageContentException>(() =>
+                {
+                    using var unexpected = TextureAllocationBudget.LoadSource(path);
+                });
+                Assert.That(pngError!.Message, Is.EqualTo("Invalid PNG data."));
+                return;
+            }
+            var error = Assert.Throws<InvalidDataException>(() =>
+            {
+                using var unexpected = TextureAllocationBudget.LoadSource(path);
+            });
+            Assert.That(error!.Message, Is.EqualTo("texture_multiframe_unsupported"));
+        }
+        catch
+        {
+            if (extension == "png" && File.Exists(path))
+            {
+                var diagnostic = Path.Combine(TestContext.CurrentContext.WorkDirectory,
+                    $"failed-apng-{frameCount}-root{animateRoot}-{Guid.NewGuid()}.png");
+                File.Copy(path, diagnostic);
+                TestContext.AddTestAttachment(diagnostic, "APNG fixture retained after failed boundary assertion");
+            }
+            throw;
+        }
+        finally { File.Delete(path); }
+    }
+
+    [Test]
+    public void SourcesAreOwnedPerMaterialRatherThanSharedGlobalCache()
+    {
+        var path = Path.Combine(Path.GetTempPath(), Guid.NewGuid() + ".png");
+        try
+        {
+            using (var fixture = new Image<Rgba32>(8, 8)) fixture.SaveAsPng(path);
+            using var first = TextureAllocationBudget.LoadSource(path);
+            using var second = TextureAllocationBudget.LoadSource(path);
+            Assert.That(ReferenceEquals(first, second), Is.False);
+            first.Dispose();
+            Assert.That(second.Width, Is.EqualTo(8));
+        }
+        finally { File.Delete(path); }
+    }
+}
