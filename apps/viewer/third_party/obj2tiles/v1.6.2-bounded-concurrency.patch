+using System.Diagnostics;
+using System.Text.Json;
+
+namespace Obj2Tiles;
+
+internal static class RuntimeDiagnostics
+{
+    private const int MaxExceptionDepth = 12;
+
+    public static bool IsResourcePressure(Exception error)
+    {
+        foreach (var current in ExceptionChain(error))
+        {
+            if (current is TaskSchedulerException or OutOfMemoryException or InsufficientMemoryException)
+                return true;
+        }
+        return false;
+    }
+
+    public static void Write(string eventName, Exception? error = null, int? fromParallelism = null, int? toParallelism = null)
+    {
+        var process = Process.GetCurrentProcess();
+        ThreadPool.GetAvailableThreads(out var availableWorkers, out var availableIo);
+        ThreadPool.GetMaxThreads(out var maxWorkers, out var maxIo);
+        var gc = GC.GetGCMemoryInfo();
+        var payload = new
+        {
+            schemaVersion = 1,
+            eventName,
+            fromParallelism,
+            toParallelism,
+            resourcePressure = error != null && IsResourcePressure(error),
+            exceptionTypes = error == null ? Array.Empty<string>() : ExceptionChain(error).Select(item => item.GetType().FullName ?? item.GetType().Name).ToArray(),
+            exceptionHResults = error == null ? Array.Empty<int>() : ExceptionChain(error).Select(item => item.HResult).ToArray(),
+            resources = new
+            {
+                processorCount = Environment.ProcessorCount,
+                processThreads = Try(() => process.Threads.Count),
+                workingSetBytes = Try(() => process.WorkingSet64),
+                privateMemoryBytes = Try(() => process.PrivateMemorySize64),
+                gcHeapBytes = GC.GetTotalMemory(false),
+                gcTotalAvailableBytes = gc.TotalAvailableMemoryBytes,
+                gcHighMemoryThresholdBytes = gc.HighMemoryLoadThresholdBytes,
+                threadPoolAvailableWorkers = availableWorkers,
+                threadPoolMaxWorkers = maxWorkers,
+                threadPoolAvailableIo = availableIo,
+                threadPoolMaxIo = maxIo,
+                cgroupPidsCurrent = ReadMetric("/sys/fs/cgroup/pids.current"),
+                cgroupPidsMax = ReadMetric("/sys/fs/cgroup/pids.max"),
+                cgroupMemoryCurrent = ReadMetric("/sys/fs/cgroup/memory.current"),
+                cgroupMemoryMax = ReadMetric("/sys/fs/cgroup/memory.max")
+            }
+        };
+        Console.Error.WriteLine("OBJ2TILES_DIAGNOSTIC " + JsonSerializer.Serialize(payload));
+    }
+
+    private static IEnumerable<Exception> ExceptionChain(Exception error)
+    {
+        var pending = new Queue<Exception>();
+        var seen = new HashSet<Exception>(ReferenceEqualityComparer.Instance);
+        pending.Enqueue(error);
+        while (pending.Count > 0 && seen.Count < MaxExceptionDepth)
+        {
+            var current = pending.Dequeue();
+            if (!seen.Add(current)) continue;
+            yield return current;
+            if (current is AggregateException aggregate)
+            {
+                foreach (var inner in aggregate.Flatten().InnerExceptions) pending.Enqueue(inner);
+            }
+            else if (current.InnerException != null)
+            {
+                pending.Enqueue(current.InnerException);
+            }
+        }
+    }
+
+    private static long? Try(Func<long> read)
+    {
+        try { return read(); }
+        catch { return null; }
+    }
+
+    private static string? ReadMetric(string file)
+    {
+        try
+        {
+            var value = File.ReadAllText(file).Trim();
+            if (value.Length is < 1 or > 32) return null;
+            return value == "max" || value.All(char.IsAsciiDigit) ? value : null;
+        }
+        catch
+        {
+            return null;
+        }
+    }
+}
