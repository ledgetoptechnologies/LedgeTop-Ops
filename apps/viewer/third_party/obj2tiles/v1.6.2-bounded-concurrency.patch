+                Marshal.Copy(allocation, guarded, 0, guarded.Length);
+                for (var i = 0; i < 3; i++) Assert.That(guarded[i], Is.EqualTo(0xA5));
+                for (var i = 0; i < expected.Length; i++) Assert.That(guarded[3 + i], Is.EqualTo(expected[i]));
+                for (var i = 3 + expected.Length; i < guarded.Length; i++) Assert.That(guarded[i], Is.EqualTo(0xA5));
