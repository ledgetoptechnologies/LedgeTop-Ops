  },
  "dependencies": {
    "@ltds/shared": "file:../../packages/shared",
    "hono": "^4.12.34",
    "jose": "^6.2.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.118.0"
  }
}
