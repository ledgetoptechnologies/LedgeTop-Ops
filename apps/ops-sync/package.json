{
  "name": "@ltds/ops-sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy --keep-vars",
