{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledgetop-ops-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "@ltds/shared": "./node_modules/@ltds/shared/src/index.ts",
    "hono/http-exception": "./node_modules/hono/dist/http-exception.js",
    "zod": "./node_modules/zod/index.js"
  },
  "routes": [
    {
      "pattern": "ops-sync.ledgetopdroneservices.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "EXPECTED_HOST": "ops-sync.ledgetopdroneservices.com",
    "TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "CF_ACCESS_AUD": "ce63abfebd59f3183002cce6c9f7a86419d1cda6f4507885c11b8b17af3ccb3c",
    "CF_ACCOUNT_ID": "846c924bf17bf4f3dd15c97a4c5d1d51",
    "CF_ACCESS_GROUP_ID": "f4dd9211-6ec4-4213-abe0-c67b8326ad02",
    "CF_ACCESS_GROUP_NAME": "LTDS Ops Users",
    "APPLICATION_KEY": "ltds_ops",
    "PROJECT_ALPHA_ALLOW_LEGACY_HMAC": "true"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "ltds-ops",
      "database_id": "6ebf7514-d306-4615-ae56-ad869c874dbd",
      "migrations_dir": "../operations/migrations"
    },
    {
      "binding": "DELIVERY_DB",
      "database_name": "client-data",
      "database_id": "7f40a7b7-c3ec-470e-a626-e798867f71f8",
      "migrations_dir": "../client/migrations"
    }
  ],
  "services": [
    {
      "binding": "CLIENT_PORTAL_PROJECTION_INGRESS",
      "service": "ledgetop-clients",
      "entrypoint": "OpsSyncPortalProjectionIngress"
    },
    {
      "binding": "OPERATIONS_DELIVERY_INTENT_INGRESS",
      "service": "ledgetop-ops",
      "entrypoint": "ProjectAlphaDeliveryIntentIngress"
    }
  ]
}
