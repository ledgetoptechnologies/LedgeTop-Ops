{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledge-top-ops-sync-staging",
  "account_id": "df3f376bae6ee621f50cf972ebcc9484",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "EXPECTED_HOST": "ledge-top-ops-sync-staging.ledge-top-staging.workers.dev",
    "TEAM_DOMAIN": "https://ledge-top-staging.cloudflareaccess.com",
    "CF_ACCESS_AUD": "61e0ecc56176cab2eaa1c007ca262e10dbd91df1cee36abf87d8a3928a720485",
    "CF_ACCOUNT_ID": "df3f376bae6ee621f50cf972ebcc9484",
    "CF_ACCESS_GROUP_ID": "REQUIRES_ALLOCATION:sync_access_group_id",
    "CF_ACCESS_GROUP_NAME": "REQUIRES_ALLOCATION:sync_access_group_name",
    "APPLICATION_KEY": "REQUIRES_ALLOCATION:sync_application_key",
    "PROJECT_ALPHA_ALLOW_LEGACY_HMAC": "false",
    "PROJECT_ALPHA_CONNECTOR_SOURCES_REQUIRED": "true"
  },
  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "ledge-top-ops-staging",
      "database_id": "a58ea102-f04d-417a-bfd1-b0654cfeb503",
      "migrations_dir": "../operations/migrations"
    },
    {
      "binding": "DELIVERY_DB",
      "database_name": "ledge-top-portal-staging",
      "database_id": "15d02028-8c52-40b2-9979-d67abf7d5bbf",
      "migrations_dir": "../client/migrations"
    }
  ],
  "services": [
    {
      "binding": "CLIENT_PORTAL_PROJECTION_INGRESS",
      "service": "ledge-top-clients-staging",
      "entrypoint": "OpsSyncPortalProjectionIngress"
    },
    {
      "binding": "OPERATIONS_DELIVERY_INTENT_INGRESS",
      "service": "ledge-top-ops-staging",
      "entrypoint": "ProjectAlphaDeliveryIntentIngress"
    }
  ]
}
