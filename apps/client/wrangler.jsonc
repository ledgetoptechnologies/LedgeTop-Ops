{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ltds-clients",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "client.ledgetopdroneservices.com",
      "custom_domain": true
    },
    {
      "pattern": "portal.ledgetopdroneservices.com",
      "custom_domain": true
    },
    {
      "pattern": "portal.ledgetoptechnologies.com",
      "custom_domain": true
    }
  ],
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 25000
  },
  "triggers": {
    "crons": ["*/5 * * * *", "15 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/s/*", "/client-share/*", "/portal*", "/assets/*", "/health"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://portal.ledgetopdroneservices.com",
    "PUBLIC_SHARE_ORIGIN": "https://portal.ledgetopdroneservices.com",
    "EXPECTED_HOST": "portal.ledgetopdroneservices.com",
    "ENVIRONMENT": "production",
    "CLIENT_PORTAL_ENABLED": "true",
    "CLIENT_PORTAL_CONTENT_AUDIT_ENABLED": "false",
    "CLIENT_PORTAL_REQUEST_V2_ENABLED": "false",
    "CLIENT_PORTAL_NATIVE_REQUESTS_ENABLED": "false",
    "CLIENT_PORTAL_NATIVE_FEEDBACK_SOURCE_IDS": "",
    "PROJECT_ALPHA_CATALOG_SYNC_ENABLED": "false",
    "PROJECT_ALPHA_CATALOG_HMAC_KEY_ID": "",
    "PROJECT_ALPHA_CATALOG_PREVIOUS_HMAC_KEY_ID": "",
    "PROJECT_ALPHA_PORTAL_SYNC_ENABLED": "false",
    "PROJECT_ALPHA_PORTAL_APPLICATION_KEY": "ltds_ops",
    "PROJECT_ALPHA_PORTAL_ACCESS_TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "PROJECT_ALPHA_PORTAL_ACCESS_AUD": "a722211a2c137a892d5a07e3bf1e1f3f49475f75efd83e12adade21a42e75068",
    "PROJECT_ALPHA_SERVICE_ASSIGNMENT_SYNC_ENABLED": "false",
    "CLIENT_PORTAL_SERVICE_ASSIGNMENT_POLICY_ENABLED": "false",
    "PROJECT_ALPHA_PORTAL_HMAC_KEY_ID": "portal-v1",
    "PROJECT_ALPHA_PORTAL_PREVIOUS_HMAC_KEY_ID": "",
    "PROJECT_ALPHA_PRICING_HINTS_ENABLED": "false",
    "PROJECT_ALPHA_PRICING_HINT_URL": "",
    "PROJECT_ALPHA_PRICING_HINT_ALLOWED_ORIGIN": "",
    "PROJECT_ALPHA_PRICING_HINT_APPLICATION_KEY": "",
    "PROJECT_ALPHA_PRICING_HINT_CURRENCIES": "USD",
    "CLIENT_REQUEST_ATTACHMENTS_ENABLED": "false",
    "CLIENT_PORTAL_TEAM_ENABLED": "false",
    "CLIENT_PORTAL_HIERARCHY_V2_ENABLED": "false",
    "CLIENT_PORTAL_PA_IDENTITY_AUTO_ELIGIBILITY_ENABLED": "false",
    "CLIENT_PORTAL_IDENTITY_DENYLIST_ENABLED": "false",
    "AUTHENTICATED_DELIVERY_GRANTS_ENABLED": "false",
    "CLIENT_VIEWER_ENABLED": "false",
    "CLIENT_VIEWER_SHARES_ENABLED": "false",
    "CLIENT_PORTAL_HIERARCHY_RELATIONS_ENABLED": "false",
    "CLIENT_PORTAL_MEMBERSHIP_MANAGEMENT_ENABLED": "false",
    "PROJECT_ACCESS_AUTHORITY_MUTATIONS_ENABLED": "false",
    "CLIENT_PORTAL_PEER_ADMIN_ENABLED": "false",
    "CLIENT_PORTAL_ADDRESS_BOOK_ENABLED": "false",
    "CLIENT_PORTAL_ACCESS_ENROLLMENT_READY": "false",
    "CLIENT_PORTAL_INVITATION_EMAIL_ENABLED": "false",
    "CLIENT_PORTAL_INVITATION_FROM": "",
    "CLIENT_PORTAL_INVITATION_FROM_NAME": "LTDS Client Portal",
    "CLIENT_DELEGATED_SHARES_ENABLED": "false",
    "CLIENT_DELEGATED_SHARE_KEY_ID": "v1",
    "CLIENT_PORTAL_ORIGIN": "https://portal.ledgetopdroneservices.com",
    "CLIENT_PORTAL_ORIGINS": "https://portal.ledgetopdroneservices.com,https://portal.ledgetoptechnologies.com",
    "LEGACY_CLIENT_ORIGINS": "https://client.ledgetopdroneservices.com",
    "CLIENT_ACCESS_TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "CLIENT_ACCESS_AUD": "0fa9c4453634e4c74d4522e2d44407a49701320b06d8f21d8a58efa21e5f947f",
    "CLIENT_ACCESS_AUDS": "0fa9c4453634e4c74d4522e2d44407a49701320b06d8f21d8a58efa21e5f947f,3bc9637846ccf4e1343b969cc8f14ed2cb0628956293463cf164c4080fa47e57",
    "TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "POLICY_AUD": "3b287fcd289bcb39813051b2d98d2dbffa04c1bcf1904a5a7c8d2de52394ee23",
    "SESSION_KEY_ID": "v1",
    "PREVIOUS_SESSION_KEY_ID": "",
    "STREAM_CUSTOMER_CODE": "",
    "R2_S3_ENDPOINT": "https://846c924bf17bf4f3dd15c97a4c5d1d51.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "client-data",
    "CLOUD_TRANSFER_DROPBOX_ENABLED": "false",
    "CLOUD_TRANSFER_GOOGLE_ENABLED": "false",
    "CLOUD_TRANSFER_GOOGLE_PICKER_CLIENT_ENABLED": "false",
    "DROPBOX_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_PICKER_API_KEY": "",
    "GOOGLE_CLOUD_PROJECT_NUMBER": ""
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "ratelimits": [
    {
      "name": "ACCESS_CODE_RATE_LIMITER",
      "namespace_id": "19462026",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_SESSION_RATE_LIMITER",
      "namespace_id": "19462027",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "PUBLIC_MANIFEST_RATE_LIMITER",
      "namespace_id": "19462028",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PUBLIC_MEDIA_RATE_LIMITER",
      "namespace_id": "19462029",
      "simple": { "limit": 180, "period": 60 }
    },
    {
      "name": "PUBLIC_BULK_RATE_LIMITER",
      "namespace_id": "19462030",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "PUBLIC_THUMBNAIL_RATE_LIMITER",
      "namespace_id": "19462031",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "PUBLIC_DOWNLOAD_RATE_LIMITER",
      "namespace_id": "19462032",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "PUBLIC_STREAM_RATE_LIMITER",
      "namespace_id": "19462033",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "r2_buckets": [
    { "binding": "DATA_BUCKET", "bucket_name": "client-data" }
  ],
  "d1_databases": [
    {
      "binding": "DELIVERY_DB",
      "database_name": "client-data",
      "database_id": "7f40a7b7-c3ec-470e-a626-e798867f71f8",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "CLIENT_DELEGATED_SHARE_SIGNER",
      "service": "ltds-ops",
      "entrypoint": "ClientDelegatedShareSigner"
    },
    {
      "binding": "VIEWER_SESSION_ISSUER",
      "service": "ltds-ops",
      "entrypoint": "ViewerSessionIssuer"
    }
  ],
  "stream": { "binding": "STREAM" }
  ,"workflows": [
    {
      "name": "ltds-bulk-download",
      "binding": "BULK_DOWNLOAD_WORKFLOW",
      "class_name": "BulkDownloadWorkflow"
    },
    {
      "name": "ltds-cloud-transfer",
      "binding": "CLOUD_TRANSFER_WORKFLOW",
      "class_name": "CloudTransferWorkflow"
    }
  ]
}
