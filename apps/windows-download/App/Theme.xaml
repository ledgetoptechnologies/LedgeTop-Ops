<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Generic Ledge Top identity: dark header, white working surface, one orange accent. -->
  <Color x:Key="OrangeColor">#EE5007</Color>
  <SolidColorBrush x:Key="Orange" Color="{StaticResource OrangeColor}" />
  <SolidColorBrush x:Key="OrangeHover" Color="#D44606" />
  <SolidColorBrush x:Key="HeaderBack" Color="#0A0A0C" />
  <SolidColorBrush x:Key="Ink" Color="#151B22" />
  <SolidColorBrush x:Key="Muted" Color="#5E6973" />
  <SolidColorBrush x:Key="Line" Color="#DFE4E8" />
  <SolidColorBrush x:Key="Page" Color="#F4F6F8" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Soft" Color="#F8FAFB" />
  <SolidColorBrush x:Key="WarnBack" Color="#FFF6E5" />
  <SolidColorBrush x:Key="WarnInk" Color="#8A5300" />
  <SolidColorBrush x:Key="ErrorBack" Color="#FDECEC" />
  <SolidColorBrush x:Key="ErrorInk" Color="#A32D2D" />
  <SolidColorBrush x:Key="DoneBack" Color="#E8F5EC" />
  <SolidColorBrush x:Key="DoneInk" Color="#1D6B3A" />
  <SolidColorBrush x:Key="SelectBack" Color="#FFF1E9" />

  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

  <!-- The approved LT mark (segmented frame, orange upper-right corner), drawn from the same paths as Operations. -->
  <DataTemplate x:Key="LtMark">
    <Viewbox Stretch="Uniform">
      <Canvas Width="776" Height="776">
        <Canvas.RenderTransform><TranslateTransform X="-238.5" Y="-226" /></Canvas.RenderTransform>
        <Path Stroke="#F5F3EF" StrokeThickness="56" Data="M273.5 655V370.5a99 99 0 0 1 99-99H605M979.5 583v274.5a99 99 0 0 1-99 99H650M605 956.5H372.5a99 99 0 0 1-99-99V703" />
        <Path Stroke="{StaticResource Orange}" StrokeThickness="56" Data="M650 271.5h230.5a99 99 0 0 1 99 99V538" />
        <Path Fill="#F5F3EF" Data="M365 370l93 92v244h135l66 94H418l-53-54zM503 453h349l54 88H780v332l-96-100V541H563z" />
      </Canvas>
    </Viewbox>
  </DataTemplate>

  <!-- Text colour is inherited from the window so buttons can set their own (white on orange). -->
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="#EEF1F4" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Opacity" Value="0.88" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Orange}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Back" Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Orange}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#B33D00" />
    <Setter Property="Padding" Value="4,2" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource Orange}" />
    <Setter Property="Background" Value="#E9EDF0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
</ResourceDictionary>
