<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(LedgeTopNativeDiagnostics)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_NATIVE_DIAGNOSTICS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopCacheRaceTest)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_CACHE_RACE_TEST</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopMemoryHydration)' == 'true' Or '$(LedgeTopMemoryHydrationTestHooks)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_MEMORY_HYDRATION</DefineConstants></PropertyGroup>
  <Target Name="RejectPackagedNativeDiagnostics" BeforeTargets="PrepareForBuild" Condition="'$(LedgeTopPackage)' == 'true' And ('$(LedgeTopNativeDiagnostics)' == 'true' Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*LEDGETOP_NATIVE_DIAGNOSTICS\s*([;,]|$)')))">
    <Error Text="Native diagnostic tracing is restricted to isolated test builds and cannot be packaged." />
  </Target>
  <PropertyGroup>
    <!-- The OS-qualified TFM supplies Microsoft's WinRT projection; no hand-written registry registration. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>LedgeTop.Files.Explorer</AssemblyName>
    <RootNamespace>LedgeTop.Files.Explorer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/WindowsDownload.Core.csproj" />
    <!-- Reuse the approved Operations favicon byte-for-byte; do not depend on an installed package's versioned path. -->
    <EmbeddedResource Include="../../operations/public/favicon.ico" LogicalName="LedgeTop.Files.Explorer.Brand.ico" />
    <InternalsVisibleTo Include="WindowsDownload.Explorer.Tests" />
    <InternalsVisibleTo Include="LedgeTop.Files" />
    <InternalsVisibleTo Include="LedgeTop.Files.Tests" />
  </ItemGroup>
</Project>
