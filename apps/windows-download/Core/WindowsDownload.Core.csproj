<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(LedgeTopCacheRaceTest)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_CACHE_RACE_TEST</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopMemoryHydration)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_MEMORY_HYDRATION</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopMemoryHydrationTestHooks)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_MEMORY_HYDRATION;LEDGETOP_MEMORY_HYDRATION_TEST_HOOKS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopNativeDiagnostics)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_NATIVE_DIAGNOSTICS</DefineConstants></PropertyGroup>
  <Target Name="RejectPackagedNativeDiagnostics" BeforeTargets="PrepareForBuild" Condition="'$(LedgeTopPackage)' == 'true' And ('$(LedgeTopNativeDiagnostics)' == 'true' Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*LEDGETOP_NATIVE_DIAGNOSTICS\s*([;,]|$)')))">
    <Error Text="Native diagnostic tracing is restricted to isolated test builds and cannot be packaged." />
  </Target>
  <Target Name="RejectPackagedMemoryHydrationTestHooks" BeforeTargets="PrepareForBuild" Condition="'$(LedgeTopPackage)' == 'true' And ('$(LedgeTopMemoryHydrationTestHooks)' == 'true' Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*LEDGETOP_MEMORY_HYDRATION_TEST_HOOKS\s*([;,]|$)')))">
    <Error Text="Memory hydration test hooks are restricted to isolated test builds and cannot be packaged." />
  </Target>
  <Target Name="RejectPackagedCacheRaceTests" BeforeTargets="PrepareForBuild" Condition="'$(LedgeTopPackage)' == 'true' And ('$(LedgeTopCacheRaceTest)' == 'true' Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*LEDGETOP_CACHE_RACE_TEST\s*([;,]|$)')))">
    <Error Text="Cache race test hooks are restricted to isolated test builds and cannot be packaged." />
  </Target>
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><AssemblyName>LedgeTop.WindowsDownload</AssemblyName></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopFreshStaging)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_AUTH_TIMING_STAGING</DefineConstants></PropertyGroup>
</Project>
