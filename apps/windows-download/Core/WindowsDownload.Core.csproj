<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(LedgeTopCacheRaceTest)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_CACHE_RACE_TEST</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopNativeDiagnostics)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_NATIVE_DIAGNOSTICS</DefineConstants></PropertyGroup>
  <Target Name="RejectPackagedNativeDiagnostics" BeforeTargets="PrepareForBuild" Condition="'$(LedgeTopPackage)' == 'true' And ('$(LedgeTopNativeDiagnostics)' == 'true' Or $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*LEDGETOP_NATIVE_DIAGNOSTICS\s*([;,]|$)')))">
    <Error Text="Native diagnostic tracing is restricted to isolated test builds and cannot be packaged." />
  </Target>
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><AssemblyName>LedgeTop.WindowsDownload</AssemblyName></PropertyGroup>
  <PropertyGroup Condition="'$(LedgeTopFreshStaging)' == 'true'"><DefineConstants>$(DefineConstants);LEDGETOP_AUTH_TIMING_STAGING</DefineConstants></PropertyGroup>
</Project>
