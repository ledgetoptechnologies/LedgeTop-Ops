{
  "$schema": "../operations/node_modules/wrangler/config-schema.json",
  "name": "ledgetop-ui-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
