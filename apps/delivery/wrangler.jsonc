{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ltds-delivery",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 25000
  },
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*", "/health"]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://delivery.ledgetopdroneservices.com",
    "EXPECTED_HOST": "delivery.ledgetopdroneservices.com",
    "ENVIRONMENT": "production",
    "TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "POLICY_AUD": "3b287fcd289bcb39813051b2d98d2dbffa04c1bcf1904a5a7c8d2de52394ee23",
    "SESSION_KEY_ID": "v1",
    "PREVIOUS_SESSION_KEY_ID": "",
    "STREAM_CUSTOMER_CODE": "",
    "R2_S3_ENDPOINT": "https://846c924bf17bf4f3dd15c97a4c5d1d51.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "client-data",
    "CLOUD_TRANSFER_DROPBOX_ENABLED": "false",
    "CLOUD_TRANSFER_GOOGLE_ENABLED": "false",
    "CLOUD_TRANSFER_GOOGLE_PICKER_CLIENT_ENABLED": "false",
    "DROPBOX_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_PICKER_API_KEY": "",
    "GOOGLE_CLOUD_PROJECT_NUMBER": ""
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "ratelimits": [
    {
      "name": "ACCESS_CODE_RATE_LIMITER",
      "namespace_id": "19462026",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PUBLIC_SESSION_RATE_LIMITER",
      "namespace_id": "19462027",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "PUBLIC_MANIFEST_RATE_LIMITER",
      "namespace_id": "19462028",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PUBLIC_MEDIA_RATE_LIMITER",
      "namespace_id": "19462029",
      "simple": { "limit": 180, "period": 60 }
    },
    {
      "name": "PUBLIC_BULK_RATE_LIMITER",
      "namespace_id": "19462030",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "PUBLIC_THUMBNAIL_RATE_LIMITER",
      "namespace_id": "19462031",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "PUBLIC_DOWNLOAD_RATE_LIMITER",
      "namespace_id": "19462032",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "PUBLIC_STREAM_RATE_LIMITER",
      "namespace_id": "19462033",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "r2_buckets": [
    { "binding": "DATA_BUCKET", "bucket_name": "client-data" }
  ],
  "d1_databases": [
    {
      "binding": "DELIVERY_DB",
      "database_name": "client-data",
      "database_id": "7f40a7b7-c3ec-470e-a626-e798867f71f8",
      "migrations_dir": "migrations"
    }
  ],
  "images": { "binding": "IMAGES" },
  "stream": { "binding": "STREAM" }
  ,"workflows": [
    {
      "name": "ltds-bulk-download",
      "binding": "BULK_DOWNLOAD_WORKFLOW",
      "class_name": "BulkDownloadWorkflow"
    },
    {
      "name": "ltds-cloud-transfer",
      "binding": "CLOUD_TRANSFER_WORKFLOW",
      "class_name": "CloudTransferWorkflow"
    }
  ]
}
