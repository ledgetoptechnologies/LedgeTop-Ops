{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "<DELIVERY_STAGING_WORKER>-staging",
  "account_id": "846c924bf17bf4f3dd15c97a4c5d1d51",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "<DELIVERY_STAGING_HOST>", "custom_domain": true },
    { "pattern": "<CLIENT_PORTAL_STAGING_HOST>", "custom_domain": true }
  ],
  "limits": { "cpu_ms": 300000, "subrequests": 25000 },
  "triggers": { "crons": ["*/5 * * * *", "15 * * * *"] },
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "not_found_handling": "single-page-application", "run_worker_first": ["/", "/api/*", "/s/*", "/client-share/*", "/health"] },
  "vars": {
    "PUBLIC_BASE_URL": "https://<CLIENT_PORTAL_STAGING_HOST>",
    "EXPECTED_HOST": "<DELIVERY_STAGING_HOST>",
    "ENVIRONMENT": "staging",
    "TEAM_DOMAIN": "https://<ACCESS_TEAM_DOMAIN>",
    "POLICY_AUD": "<DELIVERY_STAGING_ACCESS_AUD>",
    "CLIENT_PORTAL_ENABLED": "false",
    "CLIENT_PORTAL_REQUEST_V2_ENABLED": "false",
    "PROJECT_ALPHA_CATALOG_SYNC_ENABLED": "false",
    "PROJECT_ALPHA_CATALOG_APPLICATION_KEY": "ltds_client_catalog_staging",
    "PROJECT_ALPHA_CATALOG_ACCESS_TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "PROJECT_ALPHA_CATALOG_ACCESS_AUD": "<PROJECT_ALPHA_CATALOG_STAGING_ACCESS_AUD>",
    "PROJECT_ALPHA_PORTAL_SYNC_ENABLED": "false",
    "PROJECT_ALPHA_PORTAL_APPLICATION_KEY": "ltds_client_portal_staging",
    "PROJECT_ALPHA_PORTAL_ACCESS_TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "PROJECT_ALPHA_PORTAL_ACCESS_AUD": "<PROJECT_ALPHA_PORTAL_STAGING_ACCESS_AUD>",
    "PROJECT_ALPHA_PRICING_HINTS_ENABLED": "false",
    "PROJECT_ALPHA_PRICING_HINT_URL": "https://project-alpha-staging.ledgetopdroneservices.com/api/v2/integrations/ltds/pricing-hints",
    "PROJECT_ALPHA_PRICING_HINT_ALLOWED_ORIGIN": "https://project-alpha-staging.ledgetopdroneservices.com",
    "PROJECT_ALPHA_PRICING_HINT_APPLICATION_KEY": "ltds_client_pricing_staging",
    "PROJECT_ALPHA_PRICING_HINT_CURRENCIES": "USD",
    "CLIENT_REQUEST_ATTACHMENTS_ENABLED": "false",
    "CLIENT_PORTAL_TEAM_ENABLED": "false",
    "CLIENT_PORTAL_HIERARCHY_V2_ENABLED": "false",
    "CLIENT_PORTAL_HIERARCHY_RELATIONS_ENABLED": "false",
    "CLIENT_PORTAL_MEMBERSHIP_MANAGEMENT_ENABLED": "false",
    "CLIENT_PORTAL_ACCESS_ENROLLMENT_READY": "false",
    "CLIENT_PORTAL_INVITATION_EMAIL_ENABLED": "false",
    "CLIENT_PORTAL_INVITATION_FROM": "portal@<STAGING_EMAIL_DOMAIN>",
    "CLIENT_PORTAL_INVITATION_FROM_NAME": "LTDS Client Portal",
    "CLIENT_DELEGATED_SHARES_ENABLED": "false",
    "CLIENT_DELEGATED_SHARE_KEY_ID": "staging-v1",
    "CLIENT_PORTAL_ORIGIN": "https://<CLIENT_PORTAL_STAGING_HOST>",
    "CLIENT_ACCESS_TEAM_DOMAIN": "https://<ACCESS_TEAM_DOMAIN>",
    "CLIENT_ACCESS_AUD": "<DEDICATED_CLIENT_PORTAL_STAGING_ACCESS_AUD>",
    "MAPBOX_PUBLIC_TOKEN": "<CLIENT_STAGING_RESTRICTED_MAPBOX_PUBLIC_TOKEN>",
    "SESSION_KEY_ID": "staging-v1",
    "PREVIOUS_SESSION_KEY_ID": "",
    "STREAM_CUSTOMER_CODE": "",
    "R2_S3_ENDPOINT": "https://<STAGING_ACCOUNT_ID>.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "<DELIVERY_STAGING_R2_BUCKET>",
    "CLOUD_TRANSFER_DROPBOX_ENABLED": "false",
    "CLOUD_TRANSFER_GOOGLE_ENABLED": "false",
    "CLOUD_TRANSFER_GOOGLE_PICKER_CLIENT_ENABLED": "false",
    "DROPBOX_CLIENT_ID": "",
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_PICKER_API_KEY": "",
    "GOOGLE_CLOUD_PROJECT_NUMBER": ""
  },
  "secrets": {
    "required": ["DELIVERY_SESSION_SECRET", "DELIVERY_ACCESS_CODE_PEPPER", "AUDIT_IP_SECRET", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "PROJECT_ALPHA_CATALOG_HMAC_SECRET", "PROJECT_ALPHA_PORTAL_HMAC_SECRET", "PROJECT_ALPHA_PRICING_HINT_API_KEY", "PROJECT_ALPHA_PRICING_HINT_HMAC_SECRET", "CLIENT_REQUEST_ATTACHMENT_SCANNER_SECRET", "CLIENT_REQUEST_ATTACHMENT_R2_ACCESS_KEY_ID", "CLIENT_REQUEST_ATTACHMENT_R2_SECRET_ACCESS_KEY", "CLIENT_DELEGATED_SHARE_SESSION_SECRET"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "send_email": [{
    "name": "CLIENT_PORTAL_INVITATION_EMAIL",
    "allowed_sender_addresses": ["portal@<STAGING_EMAIL_DOMAIN>"]
  }],
  "ratelimits": [
    { "name": "ACCESS_CODE_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_1>", "simple": { "limit": 10, "period": 60 } },
    { "name": "PUBLIC_SESSION_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_2>", "simple": { "limit": 20, "period": 60 } },
    { "name": "PUBLIC_MANIFEST_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_3>", "simple": { "limit": 120, "period": 60 } },
    { "name": "PUBLIC_MEDIA_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_4>", "simple": { "limit": 180, "period": 60 } },
    { "name": "PUBLIC_BULK_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_5>", "simple": { "limit": 3, "period": 60 } },
    { "name": "PUBLIC_THUMBNAIL_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_6>", "simple": { "limit": 300, "period": 60 } },
    { "name": "PUBLIC_DOWNLOAD_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_7>", "simple": { "limit": 30, "period": 60 } },
    { "name": "PUBLIC_STREAM_RATE_LIMITER", "namespace_id": "<STAGING_RATE_LIMIT_8>", "simple": { "limit": 10, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "DATA_BUCKET", "bucket_name": "<DELIVERY_STAGING_R2_BUCKET>" }],
  "d1_databases": [{ "binding": "DELIVERY_DB", "database_name": "<DELIVERY_STAGING_D1_NAME>", "database_id": "<DELIVERY_STAGING_D1_ID>", "migrations_dir": "migrations" }],
  "services": [{ "binding": "CLIENT_DELEGATED_SHARE_SIGNER", "service": "ltds-ops-staging", "entrypoint": "ClientDelegatedShareSigner" }],
  "stream": { "binding": "STREAM" },
  "workflows": [
    { "name": "<BULK_DOWNLOAD_STAGING_WORKFLOW>", "binding": "BULK_DOWNLOAD_WORKFLOW", "class_name": "BulkDownloadWorkflow" },
    { "name": "<CLOUD_TRANSFER_STAGING_WORKFLOW>", "binding": "CLOUD_TRANSFER_WORKFLOW", "class_name": "CloudTransferWorkflow" }
  ]
}
