{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ltds-ops-sync-staging",
  "account_id": "846c924bf17bf4f3dd15c97a4c5d1d51",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ops-sync-staging.ledgetopdroneservices.com", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "staging",
    "EXPECTED_HOST": "ops-sync-staging.ledgetopdroneservices.com",
    "TEAM_DOMAIN": "https://ledgetoptechnologies.cloudflareaccess.com",
    "CF_ACCESS_AUD": "7b578ad388abb5c5eb550e86ddf3263af0b2a5694e8bf4810c67affa5721ec37",
    "CF_ACCOUNT_ID": "846c924bf17bf4f3dd15c97a4c5d1d51",
    "CF_ACCESS_GROUP_ID": "<STAGING_ACCESS_GROUP_ID>",
    "CF_ACCESS_GROUP_NAME": "<STAGING_ACCESS_GROUP_NAME>",
    "APPLICATION_KEY": "ltds_ops_staging",
    "PROJECT_ALPHA_ALLOW_LEGACY_HMAC": "true"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    { "binding": "OPS_DB", "database_name": "ltds-ops-staging", "database_id": "78b34173-b168-4e3d-9832-bb9d245cc6b8", "migrations_dir": "../operations/migrations" },
    { "binding": "DELIVERY_DB", "database_name": "client-data-staging", "database_id": "b6f653ab-9acd-4421-9ad0-207754b59aeb", "migrations_dir": "../client/migrations" }
  ]
}
